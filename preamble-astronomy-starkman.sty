\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble-astronomy-starkman}[2026/07/01 Astronomy commands for Starkman]

% ============================================================================
% Description
% ============================================================================
%
% This package provides astronomy-specific notation and commands for technical
% writing in astrophysics and observational astronomy. It includes:
%
% - Basic Astronomy Units: Solar mass (\Msun), parsec, year
% - Derived Astronomy Units: Milliarcsecond (\mas), kiloparsec (\kpc)
% - Datasets and Surveys: Gaia (\gaia), EUCLID (\euclid)
% - Glossary Acronyms: LoS, CoM, CDM, LCDM, LSST, SIDM
% - Software References: GitHub (\github), JAX (\jax/\jax*), NumPy (\numpy/\numpy*), 
%   SciPy (\scipy/\scipy*) with optional repository links (starred variant)
%
% All units integrate with siunitx for consistent formatting and spacing.
% Software package commands support starred variants for linked repository icons.
%

% ============================================================================
% Required Packages
% ============================================================================

\RequirePackage{preamble-base-starkman}
\RequirePackage{siunitx}
\RequirePackage[acronym]{glossaries}

% ============================================================================
% Units
% ============================================================================

% Basic Astronomy Units
\DeclareSIUnit\Msun{M_\odot}
\DeclareSIUnit\parsec{pc}
\DeclareSIUnit\year{yr}

% Derived Astronomy Units
\newcommand{\mas}{\unit{\milli\arcsecond}}
\newcommand{\kpc}{\unit{\kilo\parsec}}

% ============================================================================
% Datasets
% ============================================================================

% Survey and mission names
\newcommand{\gaia}{\textsl{Gaia}}
\newcommand{\euclid}{\acronym{EUCLID}}

% ============================================================================
% Glossaries
% ============================================================================

% Common astronomy acronyms
\newacronym{LoS}{LoS}{line-of-sight}
\newacronym{CoM}{CoM}{center of mass}
\newacronym{CDM}{CDM}{Cold Dark Matter}
\newacronym{LCDM}{$\Lambda$CDM}{$\Lambda$ Cold Dark Matter}
\newacronym{LSST}{LSST}{Legacy Survey of Space and Time}
\newacronym{SIDM}{SIDM}{self-interacting dark matter}

% ============================================================================
% Software
% ============================================================================

% Version control and development platforms
\newcommand{\github}{\textsl{GitHub}}

% Scientific computing libraries and packages
% Usage: \jax for name only, \jax* for name with link icon
\makepackage{jax}{JAX}{https://github.com/google/jax}
\makepackage{numpy}{NumPy}{https://github.com/numpy/numpy}
\makepackage{scipy}{SciPy}{https://github.com/scipy/scipy}

% `GalacticDynamics` packages
\makepackage{unxt}{unxt}{https://github.com/GalacticDynamics/unxt}
\makepackage{coordinax}{coordinax}{https://github.com/GalacticDynamics/coordinax}
\makepackage{galax}{galax}{https://github.com/GalacticDynamics/galax}
\makepackage{phasecurvefit}{phasecurvefit}{https://github.com/GalacticDynamics/phasecurvefit}
\makepackage{quaxed}{quaxed}{https://github.com/GalacticDynamics/quaxed}
\makepackage{quaxblocks}{quax-blocks}{https://github.com/GalacticDynamics/quax-blocks}

% `nstarman` Packages
\makepackage{quax}{quax}{https://github.com/nstarman/quax}


